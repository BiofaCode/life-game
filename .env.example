# Clé d'intégration Notion (https://www.notion.so/profile/integrations).
# Partage chacune des 4 bases avec l'intégration (… > Connexions).
# Serveur uniquement : ne jamais préfixer par NEXT_PUBLIC_.
NOTION_API_KEY=

# Mot de passe d'accès à l'app (fortement recommandé en production).
APP_PASSWORD=
