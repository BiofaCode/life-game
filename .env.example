# Clé d'intégration Notion (https://www.notion.so/profile/integrations).
# Partage chacune des 4 bases avec l'intégration (… > Connexions).
# Serveur uniquement : ne jamais préfixer par NEXT_PUBLIC_.
NOTION_API_KEY=

# Mot de passe d'accès à l'app (fortement recommandé en production).
APP_PASSWORD=

# Notifications push (génère une paire : npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:toi@example.com
# Secret du cron Vercel (envoyé automatiquement par Vercel dans l'en-tête Authorization)
CRON_SECRET=
